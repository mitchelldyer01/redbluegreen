#!/bin/sh
# doclint - check docs against docs/conventions.md. No dependencies
# beyond sh and awk. Usage: tools/doclint FILE...   exit 1 on any fail.
COLS=${DOCLINT_COLS:-80}
LINES=${DOCLINT_LINES:-60}
rc=0
for f in "$@"; do
  awk -v cols="$COLS" -v max="$LINES" -v f="$f" '
    length($0) > cols { printf "%s:%d: line is %d cols (max %d)\n",
                        f, NR, length($0), cols; bad=1 }
    END { if (NR > max) { printf "%s: %d lines (max %d)\n", f, NR, max;
                          bad=1 }
          exit bad }' "$f" || rc=1
done
exit $rc
